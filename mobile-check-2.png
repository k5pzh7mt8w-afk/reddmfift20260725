<body>
  <audio id="bgm" src="audio/black-gold-ambient.wav" loop preload="metadata"></audio>

  <header class="site-header" data-header>
    <a class="brand" href="#home" aria-label="ZOSS Color 中區首頁">
      <span>ZOSS</span>
      <strong>Color 中區</strong>
    </a>
