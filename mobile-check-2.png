    <div class="header-actions">
      <button class="icon-button" type="button" id="musicBtn" aria-label="播放或暫停背景音樂" title="背景音樂">
        <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <button class="icon-button" type="button" id="shareBtn" aria-label="分享網站" title="分享網站">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16.1c-.8 0-1.5.3-2 .8l-7.1-4.2a3.4 3.4 0 0 0 0-1.4L16 7.1a3 3 0 1 0-1-1.7L7.9 9.6a3 3 0 1 0 0 4.8l7.1 4.2a3 3 0 1 0 3-2.5Z"/></svg>
      </button>
      <button class="menu-button" type="button" id="menuBtn" aria-label="開啟選單" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
